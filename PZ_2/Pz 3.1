def check_rook_move():
    while True:
        try:
            print("\nВведите координаты первого поля (от 1 до 8):")
            x1 = int(input("x1: "))
            y1 = int(input("y1: "))
            print("Введите координаты второго поля (от 1 до 8):")
            x2 = int(input("x2: "))
            y2 = int(input("y2: "))

            # Защита от выхода за пределы доски
            if not (1 <= x1 <= 8 and 1 <= y1 <= 8 and 1 <= x2 <= 8 and 1 <= y2 <= 8):
                print("Ошибка: координаты должны быть в диапазоне от 1 до 8.")
                continue

            # Ладья ходит по одной линии (X или Y совпадают)
            if x1 == x2 or y1 == y2:
                print("Истина: ладья может перейти на это поле за один ход.")
            else:
                print("Ложь: ладья не может так ходить.")
            break

        except ValueError:
            print("Ошибка: вводите целые числа, а не буквы.")

